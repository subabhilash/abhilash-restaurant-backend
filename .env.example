# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development        # development | production
DEBUG=false                # true enables /api/docs and /api/openapi.json
LOG_LEVEL=info             # debug | info | warning | error

# ── Database (Neon PostgreSQL or any PostgreSQL) ───────────────────────────────
# Local:  postgresql://postgres:password@localhost:5432/restaurant_db
# Neon (pooler):  postgresql://user:pass@host-pooler.region.aws.neon.tech/db?sslmode=require&channel_binding=require
# Neon (direct):  postgresql://user:pass@host.region.aws.neon.tech/db?sslmode=require
DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/restaurant_db

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-secret-key-min-32-chars-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Cookies ────────────────────────────────────────────────────────────────────
# MUST be true in production (HTTPS only). Set false for local HTTP development.
COOKIE_SECURE=false

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Frontend URL (used for QR code links in emails) ───────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Email (Resend) ─────────────────────────────────────────────────────────────
# Get API key at: https://resend.com
# Leave empty to disable email sending (password reset will silently no-op)
RESEND_API_KEY=re_your_resend_api_key
# Use onboarding@resend.dev for testing; set your verified domain for production
RESEND_FROM_EMAIL=onboarding@resend.dev

# ── Gunicorn (production only, optional overrides) ────────────────────────────
# GUNICORN_WORKERS=2    # default: 2 for pooler, cpu*2+1 for direct
# GUNICORN_BIND=0.0.0.0:8099
